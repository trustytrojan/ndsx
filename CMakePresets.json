{
	"version": 3,
	"configurePresets": [
		{
			"name": "blocksds-release",
			"binaryDir": "${sourceDir}/build",
			"toolchainFile": "$env{BLOCKSDS}/cmake/BlocksDS.cmake",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "blocksds-debug",
			"binaryDir": "${sourceDir}/build",
			"toolchainFile": "$env{BLOCKSDS}/cmake/BlocksDS.cmake",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		}
	]
}